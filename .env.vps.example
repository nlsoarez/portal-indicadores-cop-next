# Copie para .env.vps apenas na VPS. Nunca faça commit do arquivo real.
# Para uma VPS persistente, use preferencialmente o Session Pooler do Supabase (porta 5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# KVM 4: limite conservador de conexões da aplicação.
DB_POOL_MAX_SIZE=8

# Porta local. O serviço fica preso a 127.0.0.1 e deve ser publicado por um reverse proxy.
PORTAL_PORT=8501

# Piloto Microsoft 365 — ETIT Residencial e Empresarial
# App Registration no Microsoft Entra com fluxo de cliente público habilitado.
M365_TENANT_ID=SEU_TENANT_ID
M365_CLIENT_ID=SEU_CLIENT_ID

# Menor escopo tentado primeiro. Se a política do tenant exigir outro escopo,
# ajuste aqui após validação com TI.
M365_SCOPES=Files.Read

# Não versione os links reais. Configure somente em .env.vps na Hostinger.
M365_ETIT_RESIDENTIAL_URL=https://SEU_LINK_SHAREPOINT_RESIDENCIAL
M365_ETIT_ENTERPRISE_URL=https://SEU_LINK_SHAREPOINT_EMPRESARIAL

# Fallback opcional caso o link compartilhado não resolva via /shares.
# M365_ETIT_RESIDENTIAL_DRIVE_ID=
# M365_ETIT_RESIDENTIAL_FOLDER_ID=
# M365_ETIT_ENTERPRISE_DRIVE_ID=
# M365_ETIT_ENTERPRISE_FOLDER_ID=
